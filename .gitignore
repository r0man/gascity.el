# Eldev is gone; autotools is the build system.  Ignore any stale local
# Eldev state so it cannot be committed.
/.eldev/
/Eldev-local

# Autotools (generated by ./autogen.sh and ./configure; never committed)
/configure
/Makefile
/Makefile.in
/doc/Makefile
/doc/Makefile.in
/aclocal.m4
/autom4te.cache/
/config.log
/config.status
/stamp-h1
/compile
/depcomp
/install-sh
/missing
/texinfo.tex
/build-aux/*
!/build-aux/.gitkeep
/m4/*.m4

# `make dist' tarball
/gascity-*.tar.gz

# Coverage
/coverage-final.json
/.undercover-report.json

# Gas City runtime / polecat worktree artifacts
/.gc/
/.runtime/
/worktrees/

# Editor / OS noise
*~
\#*\#
.DS_Store

# Gas City
.beads/*
!.beads/identity.toml

# Project-owned formulas are real, tracked files; every other entry under
# .beads/formulas/ is a generated symlink into the pack cache. Re-include the
# directory, ignore its contents, then track only the project-owned pair.
!.beads/formulas/
.beads/formulas/*
!.beads/formulas/user-manual-screenshots.formula.toml
!.beads/formulas/user-manual-screenshots.toml
.pi/extensions/gc-hooks.js

# Gas City local/tool state (untracked; not project content)
.agents/
plans/.gc-plans
plans/github/
